<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    form-->
    <record id="production_order_view_form" model="ir.ui.view">
        <field name="name">production form</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':0}"/>
                    <button  name="action_produce" type="object" string="Produce" class="oe_highlight"/>




                </header>
                <sheet>
                    <h1> <field name="name" readonly="1"/></h1>
                    <group>
                        <field name="product_id"/>
<!--                        <field name="variant_id"/>-->
                        <field name="quantity"/>
                        <field name="bom_id"/>

                         </group>
                    <group>
                        <notebook>
                            <page name="Components" string="Components">
                                <field name="production_line_ids">
                                    <list editable="bottom">

                        <field name="product_id"/>
                        <field name="quantity_id"/>

                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>

                </sheet>
<!--                 <chatter/>-->
            </form>
        </field>
    </record>
    <!--    list-->
    <record id="production_order_list" model="ir.ui.view">
        <field name="name">Production</field>
        <field name="model">production.order</field>
        <field name="arch" type="xml">

            <list>
<!--                    <field name="name"/>-->
                    <field name="product_id"/>
                    <field name="bom_id"/>
                    <field name="quantity"/>



            </list>
        </field>
    </record>

    <record id="production_action"  model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">production.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>