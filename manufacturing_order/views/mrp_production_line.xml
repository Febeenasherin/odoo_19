<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record  id="production_line_view_list" model="ir.ui.view">
        <field name="name">production.line.list</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
            <list>
                        <field name="production_id"/>
                        <field name="product_id"/>
                        <field name="is_material_available"/>
                        <field name="required_qty"/>
                        <field name="available_qty"/>
                        <field name="consumed_qty" />



            </list>
        </field>
    </record>

    <record id="production_line_action"  model="ir.actions.act_window">
        <field name="name">production line</field>
        <field name="res_model">mrp.production.material.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>