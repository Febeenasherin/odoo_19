<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    form-->
    <record id="material_view_form" model="ir.ui.view">
        <field name="name">material.production.form</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':0}" statusbar_visible="draft,confirm,in progress,done,cancel"/>
                    <button name="action_confirm_button" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button  name="action_in_progress" type="object" string="Progress" class="oe_highlight" invisible="state != 'in progress'"/>
                    <button  name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'done'"/>
                    <button  name="action_cancel" type="object" string="Cancel" class="oe_highlight"/>



                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                         <button name="action_consume_material" type="object" class="oe_stat_button" icon="fa-star">
                                <div class="o_stat_info">
<!--                                    <field name="purchase_count" class="o_stat_value"/>-->
                                    <span class="o_stat_text">Consume MMaterial</span>
                                </div>
                            </button>
                    </div>
<!--                     <div class="oe_button_box" name="button_box">-->
<!--                         <button name="action_open_internal" type="object" class="oe_stat_button" icon="fa-star">-->
<!--                                <div class="o_stat_info">-->
<!--                                    <field name="internal_count" class="o_stat_value"/>-->
<!--                                    <span class="o_stat_text">Internal Transfer</span>-->
<!--                                </div>-->
<!--                            </button>-->
<!--                    </div>-->

                    <h1> <field name="name" readonly="1"/>
                    </h1>
                    <group>
<!--                        <field name="name"/>-->
                        <field name="product_id"/>
                        <field name="bom_id"/>
                        <field name="quantity"/>
                        <field name="planned_date"/>

                         </group>
                         <group>
                        <notebook>
                            <page name="production" string="production">
                                <field name="material_line_ids">
                                    <list editable="bottom">
<!--                                        <field name="production_id"/>-->
                        <field name="product_id"/>
                        <field name="required_qty"/>
                        <field name="available_qty"/>
                        <field name="consumed_qty" />
                                        <field name="is_material_available"/>

                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
<!--                 <chatter/>-->
            </form>
        </field>
    </record>
    <!--    list-->
    <record  id="production_list" model="ir.ui.view">
        <field name="name">material.production.list</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">

            <list>
<!--                    <field name="name"/>-->
                <field name="name"/>
                        <field name="product_id"/>
                        <field name="bom_id"/>

                        <field name="planned_date"/>


            </list>
        </field>
    </record>

    <record id="mrp_production_action"  model="ir.actions.act_window">
        <field name="name">production</field>
        <field name="res_model">mrp.production.ext</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>