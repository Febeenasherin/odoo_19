<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!--    # add field-->
    <record id="website_product_view" model="ir.ui.view">
        <field name="name">res.config.settings.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//app[@name='website']" position="inside">
               <block title="Website Custom Testing Settings">
                   <setting string="BOM Product" help="Select product">
                       <field name="bom_product_ids" widget="many2many_tags"/>
                   </setting>
               </block>
           </xpath>
        </field>
    </record>


</odoo>
