<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="partner_form" model="ir.ui.view">

    <field name="name">partner.form.inherit</field>

    <field name="model">res.partner</field>

    <field name="inherit_id" ref="base.view_partner_form"/>

    <field name="arch" type="xml">

        <xpath expr="//sheet//button[@name='action_view_partner_invoices']" position="after">
            <button type="object" class="oe_stat_button" icon="fa-pencil-square-o"  name="action_products">
                <div class="o_stat_info">
                                    <field name="product_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Products</span>
                                </div>

            </button>

        </xpath>

       <xpath expr="//notebook" position="inside">


           <page string="Sale Order" name="Sale order">

                   <field name="sale_order_ids" options="{'no_create':True}"/>

           </page>


        </xpath>

    </field>

</record>
</odoo>