<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_ir_recent_record_own" model="ir.rule">
        <field name="name">Recently Viewed: Own Records Only</field>
        <field name="model_id" ref="model_ir_recent_record"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ir_recent_record_system" model="ir.rule">
        <field name="name">Recently Viewed: System Manager All</field>
        <field name="model_id" ref="model_ir_recent_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
