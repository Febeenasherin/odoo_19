<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_form_inherit_restricted" model="ir.ui.view">
        <field name="name">purchase.form.purchase.restrict</field>
         <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                    <xpath expr="//field[@name='partner_ref']" position="after">

                   <field name="restricted_partner" invisible="1"/>
                        <field name="value" invisible="1"/>

                </xpath>

                <xpath expr="//sheet" position="before">

                   <div class="alert alert-warning" role="alert" invisible="not show_warning">
                    <field name="show_warning" readonly="1"/>
                    </div>

                </xpath>

    </field>
    </record>
</odoo>