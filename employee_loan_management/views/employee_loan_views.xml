<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    form-->
    <record id="employee_loan_view_form" model="ir.ui.view">
        <field name="name">employee.loan.form</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="approve" class="oe_highlight"/>
                    <field name="state" widget="statusbar" options="{'clickable':0}"/>
                </header>
                <sheet>

                    <h1> <field name="name" readonly="1"/>
                    </h1>
                    <group>
                        <field name="employee_id"/>
                        <field name="loan_amount"/>
                        <field name="installment_count"/>
                        <field name="start_date"/>
                        <field name="installment_amount"/>
                        <field name="total_payable"/>
                         </group>
                        <notebook>
                            <page string="Loan" name="Loan">

                        <field name="loan_line_ids"/>
                            </page>
                        </notebook>
                </sheet>
                 <chatter/>
            </form>
        </field>
    </record>
    <!--    list-->
    <record  id="employee_loan_list" model="ir.ui.view">
        <field name="name">school.subject.list</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">

            <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="loan_amount"/>
                    <field name="installment_count"/>
                    <field name="total_payable"/>
            </list>
        </field>
    </record>

    <record id="employee_loan_action"  model="ir.actions.act_window">
        <field name="name">employee</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>
