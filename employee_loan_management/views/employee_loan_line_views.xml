<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_loan_line_form" model="ir.ui.view">
        <field name="name">employee.loan.line.form</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <form>

                <sheet>
                    <notebook>
                            <page string="Loan" name="Loan">
                    <group>
                      <field name="loan_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
                    </group>
                            </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>
    <!--    list-->
    <record  id="employee_loan_view_list" model="ir.ui.view">
        <field name="name">school.subject.list</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <list>
                        <field name="loan_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="paid"/>
            </list>
        </field>
    </record>

    <record id="employee_loan_line_action"  model="ir.actions.act_window">
        <field name="name">employee</field>
        <field name="res_model">employee.loan.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>
