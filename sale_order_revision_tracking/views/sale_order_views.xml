<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    # add field-->
    <record id="sale_order_view_inherit_smart_button" model="ir.ui.view">
        <field name="name">sale.order.view.inherit.smart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/div[@name='button_box']" position="inside">

                <div class="oe_button_box" name="button_box">
                         <button name="action_open_revision" type="object" class="oe_stat_button" icon="fa-star">
                                <div class="o_stat_info">
                                    <field name="revision_count" class="o_stat_value"/>
                                    <span class="o_stat_text">Revision</span>
                                </div>
                            </button>
                </div>
            </xpath>
        </field>
    </record>


</odoo>