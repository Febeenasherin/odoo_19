<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--    list-->
    <record  id="project_date_line_view_list" model="ir.ui.view">
        <field name="name">project.date.line.list</field>
        <field name="model">project.date.line</field>
        <field name="arch" type="xml">
            <list>
                        <field name="project_id"/>
                        <field name="month"/>
                        <field name="year"/>
                        <field name="from_date"/>
                        <field name="to_date"/>

            </list>
        </field>
    </record>

    <record id="project_line_action"  model="ir.actions.act_window">
        <field name="name">project</field>
        <field name="res_model">project.date.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>
