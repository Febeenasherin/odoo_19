    <!--    list-->
    <record  id="material_request_line_view_list" model="ir.ui.view">
        <field name="name">material.request.line.list</field>
        <field name="model">material.request.line</field>
        <field name="arch" type="xml">
            <list>
                        <field name="request_id"/>
                        <field name="product_id"/>
                        <field name="product_qty"/>
                        <field name="request_type"/>
                        <field name="vendor_ids" invisible="request_type == 'internal transfer'"/>
                        <field name="source_id" invisible="request_type == 'purchase order'"/>

                        <field name="destination_id" invisible="request_type == 'purchase order'"/>
            </list>
        </field>
    </record>

    <record id="material_request_line_action"  model="ir.actions.act_window">
        <field name="name">Material line</field>
        <field name="res_model">material.request.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>
