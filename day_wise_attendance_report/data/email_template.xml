<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="email_template_attendance_report" model="mail.template">
       <field name="name">Attendance Report</field>
       <field name="model_id" ref="model_hr_attendance"/>
       <field name="subject">Daily Attendance Report</field>
       <field name="email_from">{{user.email}}</field>
<!--       <field name="email_to">{{user.email}}</field>-->
       <field name="body_html" type="html">
           <p>Hi>,</p>
           <p>Please find attached the Daily Attendance report.</p>
           <p>This report provides an overview working hour of employee</p>
           <br/>
           <p>Regards,<br/></p>
       </field>
   </record>
</odoo>
