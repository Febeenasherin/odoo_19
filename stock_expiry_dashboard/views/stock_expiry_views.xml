<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


     <record id="test_model_view_kanban" model="ir.ui.view">
       <field name="name">test.model.view.kanban</field>
       <field name="model">stock.expiry</field>
       <field name="arch" type="xml">
           <kanban  class="o_stock_kanban">
               <field name="count_expiring"/>

<!--               <progressbar field="expired"/>-->
<!--                   colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>-->
               <templates>
                        <t t-name="card">
<!--                            <span t-if="record.device_type.raw_value === 'computer'" class="fa fa-laptop fs-1 col-1 mx-auto" title="Computer" role="img" aria-label="Computer"/>-->
<!--                            <span t-else="" class="fa fa-mobile fs-1 col-1 mx-auto" title="Mobile" role="img" aria-label="Mobile"/>-->
                            <div class="d-flex col-11">
                                <div class="d-flex flex-column ms-2">
                                    <div class="d-flex align-items-center">
                                        <h3>Number of lots expiring within the current week</h3>
                                    </div>
                                    <div class="card_body">
                                        <field name="count_expiring"/>
                                    </div>

                                </div>

                            </div>
                        </t>
                    </templates>
           </kanban>
       </field>
   </record>

    <record id="test_model_action" model="ir.actions.act_window">
       <field name="name">Expiration</field>
       <field name="res_model">stock.expiry</field>
       <field name="view_mode">kanban</field>
       <field name="view_id"
              ref="test_model_view_kanban"/>

   </record>

<menuitem id="menu_test_model"
           name="Dashboard"
           parent ="stock.menu_stock_root"
          action="test_model_action"/>


</odoo>