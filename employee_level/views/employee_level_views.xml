<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="employee_level_view_list" model="ir.ui.view" >
        <field name="name">employee.level.list</field>
        <field name="model">employee.level</field>
        <field name="arch" type="xml">
            <list string="employee level" editable="bottom" sample="1">

                        <field name="ref_no"/>
                        <field name="level"/>
                        <field name="salary"/>
            </list>
        </field>
    </record>

    <record id="employee_level_action" model="ir.actions.act_window">
        <field name="name">Employee level</field>
        <field name="res_model">employee.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_j">
                No record found .
            </p>
        </field>
    </record>



</odoo>
