<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record  id="purchase_order_list" model="ir.ui.view">
        <field name="name">purchase.order.migrtion.list</field>
        <field name="model">purchase.migration</field>
        <field name="arch" type="xml">

            <list>
<!--                    <field name="name"/>-->
                <field name="old_id"/>
                <field name="name"/>
                <field name="vendor_name"/>
                <field name="date_order"/>
                <field name="amount_total"/>

            </list>
        </field>
    </record>



    <!--    form-->
    <record id="material_view_form" model="ir.ui.view">
        <field name="name">purchase.migration.form</field>
        <field name="model">purchase.migration</field>
        <field name="arch" type="xml">
            <form>
                <header>
<!--                    <field name="state" widget="statusbar" options="{'clickable':0}"/>-->
<!--                    <button  name="action_request" type="object" string="Request" class="oe_highlight" invisible ="state !='draft'"-->
<!--                    groups="material_request.group_material_user"/>-->
<!--                    <button  name="action_first_approve" type="object" string="First Approve" class="oe_highlight" invisible="state !='requested'"-->
<!--                    groups="material_request.group_material_manager"/>-->
<!--                    <button  name="action_second_approve" type="object" string="Second Approve" class="oe_highlight" invisible="state !='first_approval'"-->
<!--                    groups="material_request.group_material_head"/>-->
<!--                    <button  name="action_reject" type="object" string="Reject" class="oe_highlight" invisible="state !='first_approval'"-->
<!--                    groups="material_request.group_material_head"/>-->



                </header>
                <sheet>


                    <h1> <field name="name" readonly="1"/>
                    </h1>
                    <group>
<!--                        <field name="name"/>-->
                        <field name="vendor_name"/>
                        <field name="date_order"/>
<!--                        <field name="quantity"/>-->
<!--                        <field name="planned_date"/>-->

                         </group>
                         <group>
                        <notebook>
                            <page name="Products" string="production">
                                <field name="line_ids">
                                    <list editable="bottom">
<!--                                        <field name="production_id"/>-->
                        <field name="product"/>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="amount" />


                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
<!--                 <chatter/>-->
            </form>
        </field>
    </record>

    <record id="purchase_order_action"  model="ir.actions.act_window">
        <field name="name">Purchase order</field>
        <field name="res_model">purchase.migration</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="purchase_order_list" />
