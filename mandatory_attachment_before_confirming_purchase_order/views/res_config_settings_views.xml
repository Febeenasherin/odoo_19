<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_settings_view" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
             <xpath expr="//app[@name='purchase']" position="inside">
               <block title="Mandatory Attachment">
                   <setting string="Require Attachment on Purchase Order Confirmation" help="attachment">
                       <field name="attachment"/>
                   </setting>
               </block>
           </xpath>
        </field>
    </record>


</odoo>