<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="partner_product_list_view" model="ir.ui.view">
       <field name="name">sale.order.product.view</field>
       <field name="model">sale.order</field>
       <field name="inherit_id" ref="sale.view_order_form"/>
       <field name="arch" type="xml">

<!--           <xpath expr="//field[@name='order_line']//form//field[@name='product_id']" position="attributes">-->
<!--               <attribute name="domain">[('id', 'in', product_ids)]</attribute>-->
<!--           </xpath>-->

           <xpath expr="//field[@name='order_line']/list" position="inside">
               <field name="product_ids"/>
           </xpath>
           <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
               <attribute name="domain">[('id', 'in', product_ids)]</attribute>
           </xpath>


       </field>
       
   </record>
</odoo>