<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_form" model="ir.ui.view">

    <field name="name">product.form.sale.count</field>

    <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>

    <field name="arch" type="xml">

       <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
           <attribute name="domain">[('approve', '=', 'approved')]</attribute>
       </xpath>

    </field>
    </record>
</odoo>