<?xml version="1.0" encoding="utf-8" ?>
<odoo>
   <record id="import_data_wizard" model="ir.ui.view">
       <field name="name">purchase.migration.wizard.import</field>
       <field name="model">sale.order.wizard</field>
       <field name="arch" type="xml">
           <form string="Import Purchase order">
               <group>
                   <group>

                       <field name="partner_id"/>
                       <field name="dominating_order_id" domain="[('id', 'in', sale_order_ids)]"/>

                   </group>
               </group>
               <footer>
                   <button
                           name="action_merge"
                       string="Import"
                       type="object"
                       class="btn-primary"/>
               </footer>
           </form>
       </field>
   </record>
   <record id="import_data_action" model="ir.actions.act_window">
       <field name="name">Import Excel</field>
       <field name="res_model">sale.order.wizard</field>
       <field name="view_mode">form</field>
       <field name="view_id" ref="import_data_wizard"/>
       <field name="target">new</field>
   </record>

</odoo>
