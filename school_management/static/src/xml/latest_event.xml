<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
	<t t-name="school_management.latest_event">
		<section class="latest_event_section">
			<h3 class="section_heading">Latest Events</h3>
            <br/>
            <br/>
            <br/>
            <div id="result_carousel" class="container carousel slide" data-bs-ride="carousel">
       	<div class="carousel-inner row w-100 mx-auto" role="listbox">

          	<t t-foreach="chunks" t-as="events" t-key="events.id">
			<div t-att-class="events[0] ? 'carousel-item active' : 'carousel-item'">
				<div class="row">
                        	<t t-foreach="events[1]" t-as="event" t-key="event.id" t-log="events[1]">
								<div class="block span3 col-3">
                               	<div class="card-group">
                                   	<div class="card">

                                        <img t-att-src="event.image" width="150" height="200"
                                             enctype="multipart/form-data"
                                             class="card-img-top" alt=""
                                             t-attf-onclick="location.href='/website/event/form/view/{{event.id}}'"
                                             style="cursor:pointer;"/>
                                        <div class="card-body">-->
                            <h5>Event Name: <span t-out="event.name"/></h5>
                        </div>
							</div>
                                   	</div>
                               	</div>

                        	</t>
                    	</div>
                	</div>
			</t>

      	</div>
    	</div>
            <a t-attf-href="#result_carousel" class="carousel-control-prev" data-bs-slide="prev" role="button"
               aria-label="Previous" title="Previous" style="color:red;">
        	<span class="fa fa-chevron-circle-left fa-2x"/>
                <span class="visually-hidden">Previous</span>
    	</a>
            <a t-attf-href="#result_carousel" class="carousel-control-next" data-bs-slide="next" role="button"
               aria-label="Next" title="Next" style="color:red;">
        	<span class="fa fa-chevron-circle-right fa-2x"/>
                <span class="visually-hidden">Next</span>
    	</a>
		</section>
	</t>
</templates>











