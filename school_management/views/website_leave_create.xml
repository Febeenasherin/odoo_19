<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- leave Create Form Template -->
        <template id="leave_form_template" name="Customer Form">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Leave Request</h3>
                                    <form action="/website/leave/create" method="post">
                                        

                                      <div class="mb-4">
                                            <label class="fom-label" for="stud_name">Name</label>
                                            <select id="stud_name" name="student_id" class="form-select">
                                         <t t-foreach="leave" t-as="leave">
                                                <option t-att-value="leave.id"><t t-esc="leave.first_name"/></option>

                                            </t>
                                            </select>

                                        </div>
<!--                                        <div class="mb-3">-->
<!--                                        <label class="form-label" for="stud_name">Name</label>-->
<!--                                        <input type="text" id="stud_name" name="sudent_id.first_name" required=""-->
<!--                                               class="form-control"-->
<!--                                        />-->
<!--                                        </div>-->
                                        <div class="mb-3">
                                            <label class="form-label" for="stud_leave">Start date</label>
                                            <input type="date" id="stud_leave" name="start_date" required=""
                                                   class="form-control"
                                            />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="stud_end">End Date</label><br/>
                                            <input type="date" id="stud_end" name="end_date" required=""
                                                   class="form-control"
                                            />
                                        </div>
                                          <div class="mb-4">
                                            <label class="fom-label" for="stud_class">Class</label>
                                            <select id="stud_class" name="class_id" class="form-select">
                                         <t t-foreach="classes" t-as="class">
                                                <option t-att-value="class.id"><t t-esc="class.name_class"/></option>

                                            </t>
                                            </select>
                                          </div>
                                        <div class="mb-4">
                                            <label class="form-label" for="stud_reason">Reason</label>
                                              <textarea id="stud_reason" class="form-control s_website_form_input"
                                                              name="reason" required="" rows="3"/>

                                        </div>
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary">Submit</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>
        <!-- Success Page -->
        <template id="student_leave_template" name="Customer Created">
            <t t-call="website.layout">
                <div class="container">
                    <h3>Leave Created Successfully!</h3>
                </div>
            </t>
        </template>
        <!-- Website Menu Record -->
        <record id="menu_leave_form" model="website.menu">
            <field name="name">Create Leave</field>
            <field name="url">/website/leave/form</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">60</field>
            <field name="group_ids" eval="[(6, 0, [ref('school_management.group_school_office_staff')])]"/>
        </record>
    </data>
</odoo>
