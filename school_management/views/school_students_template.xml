<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="student_register_list_template" name="Student list">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">

                        <div class="o_action_manager">
                            <div class="d-flex h-100 w-100">
                                <div class="o_website_preview flex-grow-1 border-top">
                                    <div class="o_iframe_container">
                                        <h3>Registered students</h3>
                                        <a href="/website/student/form" class="btn btn-primary">Register</a><br/>
                                    </div><br/>
                                    <table class="table table-striped">
                                         <thead class="table-primary">
                            <tr>
                                <th><strong>Sl.no</strong></th>
                                <th><strong>First name</strong></th>
                                <th><strong>Last name</strong></th>
                                <th><strong>email</strong></th>
                                <th><strong>Phone no</strong></th>
                                <th><strong>Class</strong></th>
                            </tr>
                        </thead>
                                 <tbody>
                            <t t-foreach="students" t-as="st">
                                <tr t-attf-onclick="location.href='/website/student/form/view/{{st.id}}'" style="cursor:pointer;">
                                    <td><t t-out="st_index+1"/></td>
<!--                                    <td><span t-esc="st_index + 1"/></td>-->
                                    <td><span t-esc="st.first_name"/></td>
                                    <td><span t-esc="st.last_name"/></td>
                                    <td><span t-esc="st.email"/></td>
                                    <td><span t-esc="st.phone_no"/></td>
                                    <td><span t-esc="st.class_id.name_class"/></td>

                                </tr>
                            </t>
                        </tbody>
                                    </table>
                                </div>
                            </div>
                                    </div>
                        </div>

                </section>
            </t>
        </template>

    <!-- Student Registration Form Template -->
        <template id="student_register_form_template" name="Student Form">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Student Registration</h3>
                                    <form action="/website/student/create" method="post"  enctype="multipart/form-data">
                                          <label class="form-label" for="imageUpload">Upload Image:</label>
                                        <input type="file" id="imageUpload" name="image" accept="image/*"/>
                                        <br/>
                                        <div class="mb-3">
                                            <label class="form-label" for="stud_name">First Name</label>
                                            <input type="text" id="stud_name" name="first_name" required="required" class="form-control"
                                            />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="stud_name2">Last Name</label>
                                            <input type="text" id="stud_name2" name="last_name" required="" class="form-control"
                                            />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" name="email" class="form-control"/>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label" for="stud_phn">Phone no</label>
                                            <input type="text" name="phone_no" id="stud_phn" class="form-control"/>
                                        </div>
                                        <div class="col">
                                            <label for="stud_gender">Gender</label>
                                            <select id="stud_gender" class="form-select" name="gender">

                                                <option value="Male">Male</option>
                                                <option value="Female">Female</option>

                                            </select>
                                        </div><br/>
                                        <div class="mb-4">
                                            <label class="fom-label" for="stud_class">Class</label>
                                            <select id="stud_class" name="class_id" class="form-select">
                                         <t t-foreach="classes" t-as="class">
                                                <option t-att-value="class.id"><t t-esc="class.name_class"/></option>

                                            </t>
                                            </select>
                                        </div>
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary" name="register">register</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>


    <!--    form view template-->
        <template id="student_form_view_template" name="Student Form view">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
<!--                                    <h3 class="mb-4 text-center">Student</h3>-->
                                    <div class="text-center mb-4">
                                        <t t-if="students.image">

<!--                                        <img t-att-src="'website/img/school.students/image/'?students.id" width="150" class="o_image_64_cover float-start me-2"/>-->
                                        <img t-att-src="'/web/image/school.students/' + str(students.id) + '/image'" width="150" height="170"/>
                                        </t>
                                    </div>

<!--                                    <img t-att-src="'/web/image/hr.employee.public/' + record.employee_id.raw_value + '/avatar_128'"-->
<!--                                    class="o_image_64_cover float-start me-2" alt="Employee's image"/>-->
                                    <div class="mb-3">
                                            <label class="form-label">First Name</label>
                                            <input type="text" t-att-value="students.first_name" required="" class="form-control" readonly="readonly"
                                            />
                                        </div>
                                    <div class="mb-3">
                                            <label class="form-label">Last Name</label>
                                            <input type="text" t-att-value="students.last_name" class="form-control" readonly="readonly"
                                            />
                                        </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" t-att-value="students.email" readonly="readonly"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Phone no</label>
                                        <input type="tel" class="form-control" t-att-value="students.phone_no" readonly="readonly"/>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Gender</label>
                                        <input type="text" class="form-control" t-att-value="students.gender" readonly="readonly"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Class</label>
                                        <input type="text" class="form-control" t-att-value="students.class_id.name_class" readonly="readonly"/>
                                    </div>
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                     <a href="/website/student/list" class="btn btn-primary">Back</a><br/>

                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <!-- Success Page -->
        <template id="student_success_template" name="Registration Successful">
            <t t-call="website.layout">
                <div class="container">
                    <h3>Student Created Successfully!</h3>
                </div>
            </t>
        </template>

         <data>
        <!-- Website Menu Record -->
        <record id="menu_student_form" model="website.menu">
            <field name="name">Student Registration</field>
            <field name="url">/website/student/list</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">60</field>

        </record>
    </data>
</odoo>






















































