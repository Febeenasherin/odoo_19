<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="systray_dropdown" owl="1">
      <Dropdown>
             <div class="new_icon">
                 <div class="icon_div">
                     <div class="toggle-icon" role="button">
                         <i id='create_order'
                            class="fa fa-cloud"
                            style="color: white; margin-bottom:10px; padding:13px;"
                            role="img" aria-label=" Weather Notification" t-on-click="shownotification"/>
                     </div>
                 </div>
             </div>
          <t t-set-slot="content">
              <DropdownItem>
<!--                  <div class="card mb-2">-->
                  <div class="card-body py-2" style="color: blue;">
                      <h3>Weather Notification</h3><br/>
                      <p>Date: <t t-esc="state.day"/></p>
                      <img t-att-src="state.icon"/>
                      <p> <t t-esc="state.weather"/></p>
                      <p>Location: <t t-esc="state.name"/> </p>
                      <p>Temperature: <t t-esc="state.temp"/></p>
                  </div>
<!--                  </div>-->

              </DropdownItem>

          </t>
      </Dropdown>
  </t>
</templates>
