<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    # add field-->
    <record id="sale_order_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.inherit1</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/list/field[@name='tax_ids']"
                   position="after">
                <field name="milestone"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="project_id" invisible="1"/>
                <button type="object" name="action_project_create" string="Create Project" invisible="project_id"/>
                <button type="object" name="action_update_project" string="Update project" invisible="not project_id"/>
            </xpath>
        </field>
    </record>


</odoo>


