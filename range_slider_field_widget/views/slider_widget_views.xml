<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    form-->
    <record id="slider_widget_view_form" model="ir.ui.view">
        <field name="name">slider.widget.form</field>
        <field name="model">slider.widget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>


                    <group>

                <field name='slider' widget='RangeSliderField' min="5" max="20"/>



                         </group>

                </sheet>

            </form>
        </field>
    </record>
    <!--    list-->
    <record  id="slider_widget_list" model="ir.ui.view">
        <field name="name">slider.widget.list</field>
        <field name="model">slider.widget</field>
        <field name="arch" type="xml">

            <list>
<!--                    <field name="name"/>-->
                    <field name="slider"/>


            </list>
        </field>
    </record>

    <record id="slider_widget_action"  model="ir.actions.act_window">
        <field name="name">Widget</field>
        <field name="res_model">slider.widget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>