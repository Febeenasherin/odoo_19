<?xml version="1.0" encoding="utf-8" ?>
<templates>
  <t t-name="FieldRangeSlider" owl="1">
      <div class="slidecontainer" t-on-change="getValue">
          <input type="range" t-att-min="state.min" t-att-max="state.max" value="state.value"/>
          <p>Value:
              <span>
                  <t t-esc="state.value"/>
              </span>
          </p>
      </div>
  </t>
</templates>


