<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    form-->
    <record id="project_template_view_form" model="ir.ui.view">
        <field name="name">project.template.form</field>
        <field name="model">project.template</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button  name="create_project" type="object" string="Create project" class="oe_highlight"/>

                </header>
                <sheet>

                    <h1> <field name="name"/>
                    </h1>
                    <group>
<!--                        <field name="requested_id"/>-->
                        <field name="partner_id"/>
                        <field name="project_manager"/>
                        <field name="company_id"/>


                         </group>

<!--                    <div class="oe_button_box" name="button_box">-->
<!--                         <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-star">-->
<!--                                <div class="o_stat_info">-->
<!--&lt;!&ndash;                                    <field name="event_count" class="o_stat_value"/>&ndash;&gt;-->
<!--                                    <span class="o_stat_text">Events</span>-->
<!--                                </div>-->
<!--                            </button>-->
<!--                    </div>-->
                         <group>
                        <notebook>
                            <page name="Task" string="Task">
                                <field name="task_ids">
                                    <list editable="bottom">

                        <field name="name"/>
                        <field name="milestone"/>
<!--                                        <field name="customer"/>-->
                        <field name="assigners" widget="many2many_tags"/>

                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
<!--                 <chatter/>-->
            </form>
        </field>
    </record>
    <!--    list-->
    <record  id="project_template_list" model="ir.ui.view">
        <field name="name">project.task.list</field>
        <field name="model">project.template</field>
        <field name="arch" type="xml">

            <list>
<!--                    <field name="name"/>-->
                    <field name="name"/>
                    <field name="partner_id"/>

            </list>
        </field>
    </record>

    <record id="project_creation_action"  model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">project.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>