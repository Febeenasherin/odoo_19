<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--    list-->
    <record  id="task_line_view_list" model="ir.ui.view">
        <field name="name">task.line.list</field>
        <field name="model">project.project.task</field>
        <field name="arch" type="xml">
            <list>
                        <field name="name"/>
                        <field name="milestone"/>
                        <field name="customer"/>
                        <field name="assigners" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="task_line_action"  model="ir.actions.act_window">
        <field name="name">Material line</field>
        <field name="res_model">project.project.task</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="view_content">
                no record found.
            </p>
        </field>
        </record>
</odoo>
