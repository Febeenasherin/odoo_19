<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data>
       <record model="ir.module.category" id="module_category_project_template">
           <field name="name">Project</field>
           <field name="sequence">5</field>
       </record>
       <record model="res.groups.privilege" id="res_groups_privilege_project_template">
           <field name="name">Project Template</field>
           <field name="category_id" ref="project_template.module_category_project_template"/>
       </record>

<!--       student group -->
       <record id="group_project_manager" model="res.groups">
           <field name="name">Manager</field>
           <field name="privilege_id" ref="res_groups_privilege_project_template"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>
   </data>
</odoo>
